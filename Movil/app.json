{
  "expo": {
    "name": "ActiveLife",
    "slug": "ActiveLife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Gemini_Generated_Logotipo.png",
    "scheme": "movil",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Gemini_Generated_Logotipo.png",
        "backgroundImage": "./assets/images/Gemini_Generated_Logotipo.png",
        "monochromeImage": "./assets/images/Gemini_Generated_Logotipo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/Gemini_Generated_Logotipo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/Gemini_Generated_Logotipo.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
